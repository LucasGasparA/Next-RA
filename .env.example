# Copie este arquivo para ".env" (não commitado) e preencha os valores.
# DATABASE_URL não precisa ser definida aqui — o docker-compose.yml já aponta
# pro serviço "db" do próprio compose.

# Senha única pra entrar no site.
APP_PASSWORD=troque-esta-senha

# Chave de sessão do Flask — gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Chave de criptografia do refresh_token — gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# 1 = usa sample_response.json em vez da API real do Reclame Aqui (pra testar
# sem token/sem tocar em dados de produção). Deixe vazio/0 em uso normal.
RADAR_DEMO=1
